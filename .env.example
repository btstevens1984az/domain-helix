# DomainHelix environment configuration
# Copy to .env and fill in values. Missing connector credentials automatically
# fall back to mock/demo mode (graceful degradation).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# SQLite (demo) or PostgreSQL (production)
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://domainhelix:domainhelix@localhost:5432/domainhelix?schema=public"

DEMO_MODE=true
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Local admin bootstrap
ADMIN_EMAIL="admin@domainhelix.local"
ADMIN_PASSWORD="DomainHelix!Admin"

# Auth: local | entra
AUTH_PROVIDER=local

# ---------------------------------------------------------------------------
# Active Directory (LDAP/LDAPS)
# ---------------------------------------------------------------------------
AD_LDAP_URL=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_BASE_DN=

# ---------------------------------------------------------------------------
# Azure Entra ID / OIDC + Microsoft Graph
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# CrowdStrike Falcon
# ---------------------------------------------------------------------------
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# ---------------------------------------------------------------------------
# Dynatrace
# ---------------------------------------------------------------------------
DYNATRACE_URL=
DYNATRACE_API_TOKEN=

# ---------------------------------------------------------------------------
# HCL BigFix
# ---------------------------------------------------------------------------
BIGFIX_URL=
BIGFIX_USERNAME=
BIGFIX_PASSWORD=

# ---------------------------------------------------------------------------
# VMware vCenter
# ---------------------------------------------------------------------------
VCENTER_URL=
VCENTER_USERNAME=
VCENTER_PASSWORD=

# ---------------------------------------------------------------------------
# Extensible connectors (optional)
# ---------------------------------------------------------------------------
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
