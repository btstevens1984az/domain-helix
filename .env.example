# DomainHelix environment configuration
# Copy to .env and fill in values. Demo fabric works offline without IdP/LDAP.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# SQLite (demo) or PostgreSQL (production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://domainhelix:domainhelix@localhost:5432/domainhelix?schema=public"

DEMO_MODE=true

# Auth.js / NextAuth — REQUIRED in any shared or production deploy
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL="http://localhost:3000"

# multi | breakglass-only hinting (UI always offers configured methods)
AUTH_PROVIDER=multi

# ---------------------------------------------------------------------------
# Breakglass / local admin (REQUIRED emergency path)
# Seeded on `npm run db:seed`. Change immediately after first boot.
# ---------------------------------------------------------------------------
BREAKGLASS_EMAIL="breakglass@domainhelix.local"
BREAKGLASS_PASSWORD="ChangeMe-DomainHelix-Breakglass-2026!"

# Legacy aliases (still honored by seed + docs)
ADMIN_EMAIL="breakglass@domainhelix.local"
ADMIN_PASSWORD="ChangeMe-DomainHelix-Breakglass-2026!"

# Group → role mapping (comma-separated CN / display names)
AUTH_ADMIN_GROUPS="DomainHelix-Admins,Domain Admins"
AUTH_SECURITY_GROUPS="DomainHelix-Security"
AUTH_INFRA_GROUPS="DomainHelix-Infra"

# ---------------------------------------------------------------------------
# Active Directory (LDAP / LDAPS) — on-prem auth
# See docs/active-directory.md
# ---------------------------------------------------------------------------
AD_LDAP_URL=
# Example: ldaps://dc01.contoso.local:636
AD_BASE_DN=
# Example: DC=contoso,DC=local
AD_BIND_DN=
AD_BIND_PASSWORD=
# Optional aliases
# AD_LDAP_BIND_DN=
# AD_LDAP_BIND_PASSWORD=
AD_USER_FILTER="(|(sAMAccountName={{username}})(userPrincipalName={{username}})(mail={{username}}))"
AD_GROUP_ATTRIBUTE=memberOf
# Only for lab certs — never in production
AD_LDAP_TLS_INSECURE=false

# ---------------------------------------------------------------------------
# Azure Entra ID / OIDC (Enterprise Application)
# See docs/entra-enterprise-app.md
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Set true when using federated credentials instead of a client secret
ENTRA_FEDERATED_CREDENTIAL=false

# ---------------------------------------------------------------------------
# SAML 2.0 SSO (cloud IdPs)
# See docs/saml-sso.md
# SP Entity ID default: {NEXTAUTH_URL}/api/auth/saml/metadata
# ACS URL default:      {NEXTAUTH_URL}/api/auth/saml/acs
# ---------------------------------------------------------------------------
SAML_ENABLED=false
SAML_SP_ENTITY_ID=
SAML_ACS_URL=
SAML_NAMEID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
SAML_GROUP_ATTRIBUTE=groups
SAML_WANT_ASSERTIONS_SIGNED=true
SAML_WANT_RESPONSE_SIGNED=false

# Generic SAML 2.0 IdP
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_CERT=
SAML_IDP_METADATA_URL=

# Entra ID SAML
SAML_ENTRA_SSO_URL=
SAML_ENTRA_ENTITY_ID=
SAML_ENTRA_CERT=
SAML_ENTRA_METADATA_URL=

# Okta SAML
SAML_OKTA_SSO_URL=
SAML_OKTA_ENTITY_ID=
SAML_OKTA_CERT=
SAML_OKTA_METADATA_URL=

# PingFederate / PingOne
SAML_PING_SSO_URL=
SAML_PING_ENTITY_ID=
SAML_PING_CERT=
SAML_PING_METADATA_URL=

# OneLogin
SAML_ONELOGIN_SSO_URL=
SAML_ONELOGIN_ENTITY_ID=
SAML_ONELOGIN_CERT=
SAML_ONELOGIN_METADATA_URL=

# Google Workspace SAML
SAML_GOOGLE_SSO_URL=
SAML_GOOGLE_ENTITY_ID=
SAML_GOOGLE_CERT=
SAML_GOOGLE_METADATA_URL=
