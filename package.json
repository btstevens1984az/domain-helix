{
  "name": "domain-helix",
  "version": "1.0.0",
  "private": false,
  "description": "Living digital twin of hybrid identity infrastructure — AD, Entra ID, CrowdStrike, Dynatrace, BigFix, VMware",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@xyflow/react": "^12.12.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "5.22.0",
    "puppeteer": "^23.11.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "sharp@0.33.5": true
  }
}
